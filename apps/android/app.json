{
  "expo": {
    "name": "Agent",
    "slug": "dsh-agent",
    "scheme": "dshremote",
    "version": "0.6.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.howlearnwood.agent",
      "buildNumber": "51"
    },
    "android": {
      "package": "com.howlearnwood.agent",
      "versionCode": 51,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/with-remote-foreground-service.cjs",
      "expo-file-system",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-brand.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": [
              "en-US",
              "zh-CN"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "61c55e4e-03c6-4faa-b7b7-dd9ac3f92175"
      }
    },
    "owner": "shuohigh",
    "updates": {
      "url": "https://u.expo.dev/61c55e4e-03c6-4faa-b7b7-dd9ac3f92175"
    }
  }
}
